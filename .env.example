# Copy this to apps/api/.env and fill in real values.
# The app works fully without the AI keys — profile, prediction, and college
# features don't need them. The AI chat degrades gracefully with a clear
# "not configured" message until OPENROUTER_API_KEY is set.

# PostgreSQL + pgvector since Phase 2 (see README, "Database"). SQLite still works for a quick
# start without memory features: DATABASE_URL=sqlite:///./data/app.db
DATABASE_URL=postgresql+psycopg://maya:<password>@localhost:5432/maya
# Where scripts/sqlite_to_postgres.py copies to, and an empty database the tests can use with
# MAYA_TEST_DATABASE_URL=... (the default tests run on in-memory SQLite).
POSTGRES_URL=postgresql+psycopg://maya:<password>@localhost:5432/maya
POSTGRES_TEST_URL=postgresql+psycopg://maya:<password>@localhost:5432/maya_test

# Generate your own with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-random-64-char-hex-string

CORS_ORIGINS=["http://localhost:3000"]

# Which implementation each AI service uses.
LLM_PROVIDER=openrouter        # openrouter | openai_compatible
STT_PROVIDER=groq              # groq | none
TTS_PROVIDER=cartesia          # cartesia | none

# LLM via OpenRouter (https://openrouter.ai/keys) — OpenAI-compatible, model swappable.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# LLM via any other OpenAI-compatible server, with LLM_PROVIDER=openai_compatible
# (OpenAI, or a local llama.cpp / Ollama server — those usually need no key).
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# STT via Groq (https://console.groq.com/keys) — Whisper transcription.
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3

# TTS via Cartesia (https://play.cartesia.ai/keys)
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
