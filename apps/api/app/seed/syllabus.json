{
  "_about": "Chapter-by-chapter study plans for JEE and NEET, built on the current (rationalised, 2023-24 onward) NCERT textbooks that the NTA syllabi for JEE Main and NEET-UG follow. 'weight: high' marks chapters that past papers have tested heavily — a guide for where to spend time, not a promise. 'extra' lists exam-syllabus topics the current NCERT books no longer cover.",
  "sources": [
    {"name": "NCERT textbooks (free PDFs and e-books)", "url": "https://ncert.nic.in/textbook.php"},
    {"name": "JEE Main — official syllabus and past papers (NTA)", "url": "https://jeemain.nta.nic.in"},
    {"name": "NEET-UG — official syllabus (NTA)", "url": "https://neet.nta.nic.in"},
    {"name": "JEE Advanced — syllabus and past papers", "url": "https://jeeadv.ac.in"}
  ],
  "phases": {
    "11": [
      {"title": "Now → end of Class 11", "detail": "Finish Class 11 chapters in school order. Read the NCERT chapter first, then solve its exercises and exemplar problems the same week."},
      {"title": "Every Sunday", "detail": "One subject test in MAYA's Mock Tests on what you covered that week. Note every mistake in a notebook."},
      {"title": "Summer after Class 11", "detail": "Revise the high-weight Class 11 chapters — Class 12 builds directly on them."}
    ],
    "12": [
      {"title": "April → December", "detail": "Class 12 chapters, and one Class 11 chapter revised every week alongside."},
      {"title": "January → the exam", "detail": "A full-length mock every week, then two a week. Spend as long reviewing each paper as you spent sitting it."},
      {"title": "Last month", "detail": "Only revision and mocks — no new books. Re-read your mistakes notebook and NCERT summaries."}
    ]
  },
