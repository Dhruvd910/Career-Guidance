.env
.env.local
apps/api/.env
apps/web/.env.local

# OS
.DS_Store

# Editors
.vscode/
.idea/

# Runtime PID/log files from start.sh/stop.sh
.run/

# Offline speech model for the "Maya" wake word (downloaded, ~55MB)
apps/desktop/models/

# Derived mascot GIFs (scale_mascots.sh regenerates them)
